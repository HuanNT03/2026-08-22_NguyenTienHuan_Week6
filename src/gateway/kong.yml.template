# ==============================================================================
# PROJECT SENTINEL - KONG API GATEWAY DECLARATIVE CONFIGURATION TEMPLATE
# Mode: DB-less (KONG_DATABASE=off)
# Target Service: OWASP Juice Shop (http://juice-shop:3000)
# ==============================================================================

_format_version: "3.0"
_transform: true

# ------------------------------------------------------------------------------
# 1. SERVICES & BACKEND UPSTREAM CONFIGURATION
# ------------------------------------------------------------------------------
services:
  - name: juice-shop-service
    host: juice-shop
    port: 3000
    protocol: http
    connect_timeout: 5000
    read_timeout: 5000
    write_timeout: 5000

    # Service-Level Plugins applied to ALL traffic through Gateway
    plugins:
      # Payload size limit: 1MB maximum
      - name: request-size-limiting
        config:
          allowed_payload_size: 1

      # Service-Level Pre-Function: AI Agent Zero Trust Authorization Policy
      # Rules:
      # 1. If request contains x-api-key / apikey header:
      #    a. Must match ${AGENT_API_KEY}. If invalid -> 401 Unauthorized.
      #    b. Must match allowed path in ${ALLOWED_PATHS_LUA}. If not allowed -> 403 Forbidden.
      # 2. If x-api-key header is absent -> Allows public guest/user traffic to proceed to route rules.
      - name: pre-function
        config:
          access:
            - |
              local key = kong.request.get_header("x-api-key") or kong.request.get_header("apikey")
              if key and key ~= "" then
                local valid_key = "${AGENT_API_KEY}"
                if key ~= valid_key then
                  return kong.response.exit(401, { message = "Invalid authentication credentials" })
                end

                local path = kong.request.get_path()
                local allowed_paths = { ${ALLOWED_PATHS_LUA} }

                if not allowed_paths[path] then
                  return kong.response.exit(403, { message = "You cannot consume this service" })
                end
              end

      # Service-Level Key-Auth: Resolves consumer identity
      # Valid key -> consumer: ai-agent
      # No key -> consumer: anonymous-user
      - name: key-auth
        config:
          key_names:
            - x-api-key
            - apikey
          hide_credentials: true
          anonymous: anonymous-user

      # Service-Level ACL: Enforces group access
      - name: acl
        config:
          allow:
            - agent-group
            - guest-group
            - user-group

    # --------------------------------------------------------------------------
    # 2. ROUTES & ACCESS CONTROL DEFINITIONS
    # --------------------------------------------------------------------------
    routes:
      # Route: SPA Root (Exact match only - NO catch-all wildcard)
      - name: route-spa-root
        paths:
          - ~^/$
          - /index.html
        methods:
          - GET
          - HEAD
          - OPTIONS
        strip_path: false
        plugins:
          - name: rate-limiting
            config:
              minute: 60
              policy: local

      # Route: SPA Static Assets (CSS, JS, Fonts, Images at root & /assets, /vendor)
      - name: route-spa-assets
        paths:
          - /assets
          - /vendor
          - ~^/[a-zA-Z0-9_.-]+\.(js|css|ico|png|svg|woff2?|map)$
        methods:
          - GET
          - HEAD
          - OPTIONS
        strip_path: false
        plugins:
          - name: rate-limiting
            config:
              minute: 100
              policy: local

      # Route: Browse Products & Search
      - name: route-products-browse
        paths:
          - /api/Products
          - /rest/products/search
        methods:
          - GET
          - OPTIONS
        strip_path: false
        plugins:
          - name: rate-limiting
            config:
              minute: 60
              policy: local

      # Route: Read Product Reviews
      - name: route-product-reviews-read
        paths:
          - ~/rest/products/\d+/reviews$
        methods:
          - GET
          - OPTIONS
        strip_path: false
        plugins:
          - name: rate-limiting
            config:
              minute: 60
              policy: local

      # Route: User Login
      - name: route-user-login
        paths:
          - /rest/user/login
        methods:
          - POST
          - OPTIONS
        strip_path: false
        plugins:
          - name: rate-limiting
            config:
              minute: 30
              policy: local

      # Route: User Whoami
      - name: route-whoami
        paths:
          - /rest/user/whoami
        methods:
          - GET
          - OPTIONS
        strip_path: false
        plugins:
          - name: rate-limiting
            config:
              minute: 60
              policy: local

      # Route: Guest User Registration (Strictly NO agent)
      - name: route-guest-register
        paths:
          - /api/Users
        methods:
          - POST
          - OPTIONS
        strip_path: false
        plugins:
          - name: rate-limiting
            config:
              minute: 20
              policy: local

      # Route: Password Reset
      - name: route-reset-password
        paths:
          - /rest/user/reset-password
        methods:
          - POST
          - OPTIONS
        strip_path: false
        plugins:
          - name: rate-limiting
            config:
              minute: 20
              policy: local

      # Route: Security Questions
      - name: route-security-question
        paths:
          - /rest/user/security-question
          - /api/SecurityQuestions
        methods:
          - GET
          - OPTIONS
        strip_path: false
        plugins:
          - name: rate-limiting
            config:
              minute: 60
              policy: local

      # Route: Read Basket (Authenticated Users)
      - name: route-basket-read
        paths:
          - ~/rest/basket/\d+$
        methods:
          - GET
          - OPTIONS
        headers:
          authorization:
            - "~^Bearer "
        strip_path: false
        plugins:
          - name: rate-limiting
            config:
              minute: 100
              policy: local

      # Route: Basket Checkout (Authenticated Users)
      - name: route-basket-checkout
        paths:
          - ~/rest/basket/\d+/checkout$
        methods:
          - POST
          - OPTIONS
        headers:
          authorization:
            - "~^Bearer "
        strip_path: false
        plugins:
          - name: rate-limiting
            config:
              minute: 100
              policy: local

      # Route: Basket Items CRUD (Authenticated Users)
      - name: route-basket-items
        paths:
          - /api/BasketItems
        methods:
          - GET
          - POST
          - PUT
          - DELETE
          - OPTIONS
        headers:
          authorization:
            - "~^Bearer "
        strip_path: false
        plugins:
          - name: rate-limiting
            config:
              minute: 100
              policy: local

      # Route: Order History (Authenticated Users)
      - name: route-order-history
        paths:
          - /rest/order-history
        methods:
          - GET
          - OPTIONS
        headers:
          authorization:
            - "~^Bearer "
        strip_path: false
        plugins:
          - name: rate-limiting
            config:
              minute: 100
              policy: local

      # Route: User Profile (Authenticated Users)
      - name: route-profile
        paths:
          - /profile
        methods:
          - GET
          - POST
          - OPTIONS
        headers:
          authorization:
            - "~^Bearer "
        strip_path: false
        plugins:
          - name: rate-limiting
            config:
              minute: 100
              policy: local

      # Route: Profile Image File Upload (Authenticated Users)
      - name: route-profile-image-upload
        paths:
          - /profile/image/file
        methods:
          - POST
          - OPTIONS
        headers:
          authorization:
            - "~^Bearer "
        strip_path: false
        plugins:
          - name: rate-limiting
            config:
              minute: 50
              policy: local

# ------------------------------------------------------------------------------
# 3. CONSUMER-SCOPED PLUGINS
# ------------------------------------------------------------------------------
plugins:
  # Dedicated Rate Limiting for AI Security Agent: 20 requests per minute
  - name: rate-limiting
    consumer: ai-agent
    config:
      minute: 20
      policy: local

# ------------------------------------------------------------------------------
# 4. CONSUMERS & CREDENTIALS DEFINITIONS
# ------------------------------------------------------------------------------
consumers:
  # AI Security Agent Consumer
  - username: ai-agent
    keyauth_credentials:
      - key: "${AGENT_API_KEY}"
    acls:
      - group: agent-group

  # Anonymous / Unauthenticated Guest Consumer Fallback
  - username: anonymous-user
    acls:
      - group: guest-group

  # Authenticated Juice Shop Users Consumer
  - username: juice-shop-users
    acls:
      - group: user-group
