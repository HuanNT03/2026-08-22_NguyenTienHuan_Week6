# ==============================================================================
# PROJECT SENTINEL - KONG API GATEWAY DECLARATIVE CONFIGURATION TEMPLATE
# Mode: DB-less (KONG_DATABASE=off)
# Target Service: OWASP Juice Shop (http://juice-shop:3000)
# ==============================================================================

_format_version: "3.0"
_transform: true

# ------------------------------------------------------------------------------
# 1. SERVICES & BACKEND UPSTREAM CONFIGURATION
# ------------------------------------------------------------------------------
services:
  - name: juice-shop-service
    host: juice-shop
    port: 3000
    protocol: http
    connect_timeout: 5000
    read_timeout: 5000
    write_timeout: 5000

    # Service-Level Plugins applied to ALL traffic through Gateway
    plugins:
      # Payload size limit: 1MB maximum
      - name: request-size-limiting
        config:
          allowed_payload_size: 1

      # Service-Level Pre-Function: AI Agent Zero Trust Authorization Policy
      # Rules:
      # 1. If request contains x-api-key / apikey header:
      #    a. Must match ${AGENT_API_KEY}. If invalid -> 401 Unauthorized.
      #    b. Must match allowed path in ${ALLOWED_PATHS_LUA}. If not allowed -> 403 Forbidden.
      # 2. If x-api-key header is absent -> Allows public guest/user traffic to proceed to route rules.
      - name: pre-function
        config:
          access:
            - |
              local key = kong.request.get_header("x-api-key") or kong.request.get_header("apikey")
              if key and key ~= "" then
                local valid_key = "${AGENT_API_KEY}"
                if key ~= valid_key then
                  return kong.response.exit(401, { message = "Invalid authentication credentials" })
                end

                local path = kong.request.get_path()
                local allowed_paths = { ${ALLOWED_PATHS_LUA} }

                if not allowed_paths[path] then
                  return kong.response.exit(403, { message = "You cannot consume this service" })
                end
              end

      # Service-Level Key-Auth: Resolves consumer identity
      # Valid key -> consumer: ai-agent
      # No key -> consumer: anonymous-user
      - name: key-auth
        config:
          key_names:
            - x-api-key
            - apikey
          hide_credentials: true
          anonymous: anonymous-user

      # Service-Level ACL: Enforces group access
      - name: acl
        config:
          allow:
            - agent-group
            - guest-group
            - user-group

    # --------------------------------------------------------------------------
    # 2. DYNAMICALLY GENERATED ROUTES (Compiled from allowlist.json at Boot-Time)
    # --------------------------------------------------------------------------
    routes:
${GENERATED_ROUTES_YAML}

# ------------------------------------------------------------------------------
# 3. CONSUMER-SCOPED PLUGINS
# ------------------------------------------------------------------------------
plugins:
  # Dedicated Rate Limiting for AI Security Agent: 20 requests per minute
  - name: rate-limiting
    consumer: ai-agent
    config:
      minute: 20
      policy: local

# ------------------------------------------------------------------------------
# 4. CONSUMERS & CREDENTIALS DEFINITIONS
# ------------------------------------------------------------------------------
consumers:
  # AI Security Agent Consumer
  - username: ai-agent
    keyauth_credentials:
      - key: "${AGENT_API_KEY}"
    acls:
      - group: agent-group

  # Anonymous / Unauthenticated Guest Consumer Fallback
  - username: anonymous-user
    acls:
      - group: guest-group

  # Authenticated Juice Shop Users Consumer
  - username: juice-shop-users
    acls:
      - group: user-group
