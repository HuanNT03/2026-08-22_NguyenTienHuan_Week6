{
  "clients": {
    "agent": {
      "consumer": "ai-agent",
      "auth_method": "key-auth",
      "rate_limit_per_minute": 20
    },
    "guest": {
      "consumer": "anonymous-user",
      "auth_method": "anonymous",
      "rate_limit_per_minute": 60
    },
    "user": {
      "consumer": "juice-shop-users",
      "auth_method": "jwt",
      "rate_limit_per_minute": 100
    }
  },
  "routes": [
    {
      "name": "route-spa-root",
      "paths": ["~/$", "/index.html"],
      "methods": ["GET", "HEAD", "OPTIONS"],
      "allow": ["agent", "guest", "user"],
      "_note": "Khớp chính xác duy nhất trang chủ gốc / và index.html — Regex bắt đầu bằng ~/"
    },
    {
      "name": "route-spa-assets",
      "paths": [
        "/assets",
        "/vendor",
        "/media",
        "/i18n",
        "~/[a-zA-Z0-9_.-]+\\.(js|css|ico|png|svg|woff2?|map|json)$"
      ],
      "methods": ["GET", "HEAD", "OPTIONS"],
      "allow": ["agent", "guest", "user"],
      "_note": "Cho phép tải static assets, fonts trong /media, /vendor, i18n và JS/CSS bundles"
    },
    {
      "name": "route-products-browse",
      "paths": ["/api/Products", "~/api/Products/\\d+$", "/rest/products/search"],
      "methods": ["GET"],
      "allow": ["agent", "guest", "user"]
    },
    {
      "name": "route-product-reviews",
      "paths": ["~/rest/products/\\d+/reviews$"],
      "methods": ["GET", "PUT"],
      "allow": ["agent", "guest", "user"]
    },
    {
      "name": "route-quantities-browse",
      "paths": ["/api/Quantitys", "~/api/Quantitys/.*$"],
      "methods": ["GET"],
      "allow": ["agent", "guest", "user"],
      "_note": "Hiển thị số lượng tồn kho sản phẩm cho giao diện"
    },
    {
      "name": "route-app-meta",
      "paths": [
        "/rest/admin/application-version",
        "/rest/admin/application-configuration",
        "/rest/languages",
        "/rest/captcha"
      ],
      "methods": ["GET"],
      "allow": ["agent", "guest", "user"],
      "_note": "Thông tin phiên bản, cấu hình ứng dụng và ngôn ngữ cho SPA"
    },
    {
      "name": "route-feedbacks",
      "paths": ["/api/Feedbacks"],
      "methods": ["GET", "POST"],
      "allow": ["agent", "guest", "user"]
    },
    {
      "name": "route-deliverys",
      "paths": ["/api/Deliverys", "~/api/Deliverys/\\d+$"],
      "methods": ["GET"],
      "allow": ["agent", "guest", "user"]
    },
    {
      "name": "route-challenges",
      "paths": ["/api/Challenges", "/rest/continue-code"],
      "methods": ["GET"],
      "allow": ["agent", "guest", "user"]
    },
    {
      "name": "route-user-login",
      "paths": ["/rest/user/login"],
      "methods": ["POST"],
      "allow": ["agent", "guest", "user"]
    },
    {
      "name": "route-whoami",
      "paths": ["/rest/user/whoami"],
      "methods": ["GET"],
      "allow": ["agent", "guest", "user"]
    },
    {
      "name": "route-guest-register",
      "paths": ["/api/Users", "/api/SecurityAnswers"],
      "methods": ["POST"],
      "allow": ["guest", "user"],
      "_note": "Cố ý KHÔNG có 'agent' — Agent không cần tự đăng ký tài khoản"
    },
    {
      "name": "route-reset-password",
      "paths": ["/rest/user/reset-password"],
      "methods": ["POST"],
      "allow": ["guest", "user"]
    },
    {
      "name": "route-security-question",
      "paths": ["/rest/user/security-question", "/api/SecurityQuestions"],
      "methods": ["GET"],
      "allow": ["guest", "user"]
    },
    {
      "name": "route-basket-read",
      "paths": ["~/rest/basket/\\d+$"],
      "methods": ["GET"],
      "allow": ["user"]
    },
    {
      "name": "route-basket-checkout",
      "paths": ["~/rest/basket/\\d+/checkout$"],
      "methods": ["POST"],
      "allow": ["user"]
    },
    {
      "name": "route-basket-items",
      "paths": ["/api/BasketItems", "~/api/BasketItems/\\d+$"],
      "methods": ["GET", "POST", "PUT", "DELETE"],
      "allow": ["user"]
    },
    {
      "name": "route-order-history",
      "paths": ["/rest/order-history"],
      "methods": ["GET"],
      "allow": ["user"]
    },
    {
      "name": "route-cards",
      "paths": ["/api/Cards", "~/api/Cards/\\d+$"],
      "methods": ["GET", "POST", "DELETE"],
      "allow": ["user"]
    },
    {
      "name": "route-address",
      "paths": ["/api/Addresss", "~/api/Addresss/\\d+$"],
      "methods": ["GET", "POST", "PUT", "DELETE"],
      "allow": ["user"]
    },
    {
      "name": "route-profile",
      "paths": ["/profile"],
      "methods": ["GET", "POST"],
      "allow": ["user"]
    },
    {
      "name": "route-profile-image-upload",
      "paths": ["/profile/image/file"],
      "methods": ["POST"],
      "allow": ["user"]
    }
  ]
}
