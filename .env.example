# OWASP Juice Shop configuration
JUICE_SHOP_PORT=3000

# Semgrep configuration
SEMGREP_APP_TOKEN=your-semgrep-app-token-here

# Security Analysis Agent (LLM) configuration
# Example for Alibaba DashScope / Qwen:
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# Example for OpenRouter:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=qwen/qwen-2.5-72b-instruct
LLM_API_KEY=your-llm-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=2

# Embedding Provider Configuration (for Dense Vector & Two-Stage Hybrid Retrieval)
# Supported providers: 'fastembed' (Local ONNX, offline, free), 'dashscope' (Alibaba), 'openai', 'mock'
EMBEDDING_PROVIDER=fastembed

# 1. Example for Local Offline Semantic Search (FastEmbed ONNX - No API key required):
# EMBEDDING_PROVIDER=fastembed
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIMENSION=384

# 2. Example for Alibaba DashScope / Qwen:
# EMBEDDING_PROVIDER=dashscope
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIMENSION=1024

# 3. Example for OpenAI:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# Active default configuration:
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
