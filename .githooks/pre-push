#!/usr/bin/env sh

set -eu

HOOK_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
# shellcheck source=.githooks/lib/gitleaks-common.sh
. "$HOOK_DIR/lib/gitleaks-common.sh"

REPOSITORY_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPOSITORY_ROOT"

if ! gitleaks_is_ready; then
  exit 0
fi

is_zero_oid() {
  case "$1" in
    '' | *[!0]*) return 1 ;;
    *) return 0 ;;
  esac
}

is_hex_oid() {
  case "$1" in
    '' | *[!0-9a-fA-F]*) return 1 ;;
    *) return 0 ;;
  esac
}

while read -r local_ref local_oid remote_ref remote_oid; do
  [ -n "${local_ref:-}" ] || continue

  if ! is_hex_oid "$local_oid" || ! is_hex_oid "$remote_oid"; then
    printf 'ERROR: Refusing to scan invalid Git object IDs for %s.\n' "$local_ref" >&2
    exit 2
  fi

  if is_zero_oid "$local_oid"; then
    continue
  fi

  if is_zero_oid "$remote_oid"; then
    log_options="$local_oid"
  else
    log_options="$remote_oid..$local_oid"
  fi

  printf 'Gitleaks: scanning outgoing history for %s -> %s.\n' "$local_ref" "$remote_ref"
  gitleaks git --redact --verbose --log-opts="$log_options" . || exit $?
done
