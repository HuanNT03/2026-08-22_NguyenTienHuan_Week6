# OWASP Juice Shop is cloned locally from target-app/TARGET.lock.
/target-app/juice-shop/

# Raw scanner reports are generated locally and uploaded as CI artifacts.
/reports/raw/*
!/reports/raw/.gitkeep

# Runtime logs may contain environment-specific or sensitive data.
/logs/*
!/logs/.gitkeep

# Environment variables
.env
.env.*
!.env.example

# Generated normalized findings and Python caches.
/reports/normalized/*
!/reports/normalized/.gitkeep
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/

# Generated knowledge-base index.
/knowledge-base/index/*
!/knowledge-base/index/.gitkeep
