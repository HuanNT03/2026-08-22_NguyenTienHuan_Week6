{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.local/schemas/unified_findings.schema.json",
  "title": "Project Sentinel Unified Finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "finding_id", "fingerprint", "group_key", "tool", "scan", "target", "rule", "title", "description", "categories", "severity", "confidence", "cwe_ids", "owasp_categories", "wasc_ids", "location", "evidence", "data_flow", "solution", "references", "normalization", "raw_sources"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "finding_id": {"type": "string", "pattern": "^fnd_[0-9a-f]{32}$"},
    "fingerprint": {"type": "string", "pattern": "^fp_sha256:v1:[0-9a-f]{64}$"},
    "group_key": {"type": "string", "pattern": "^grp_sha256:v1:[0-9a-f]{64}$"},
    "tool": {"$ref": "#/$defs/tool"},
    "scan": {"$ref": "#/$defs/scan"},
    "target": {"$ref": "#/$defs/target"},
    "rule": {"$ref": "#/$defs/rule"},
    "title": {"type": ["string", "null"]},
    "description": {"type": ["string", "null"]},
    "categories": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "severity": {"enum": ["info", "low", "medium", "high", "critical", "unknown"]},
    "confidence": {"enum": ["false_positive", "low", "medium", "high", "confirmed", "unknown"]},
    "cwe_ids": {"type": "array", "items": {"type": "string", "pattern": "^CWE-[1-9][0-9]*$"}, "uniqueItems": true},
    "owasp_categories": {"type": "array", "items": {"type": "string", "pattern": "^OWASP-A(0[1-9]|10):[0-9]{4}$"}, "uniqueItems": true},
    "wasc_ids": {"type": "array", "items": {"type": "string", "pattern": "^WASC-[1-9][0-9]*$"}, "uniqueItems": true},
    "location": {"oneOf": [{"$ref": "#/$defs/code_location"}, {"$ref": "#/$defs/http_location"}]},
    "evidence": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["message"], "properties": {"message": {"type": ["string", "null"]}}}]},
    "data_flow": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/data_flow"}}]},
    "solution": {"type": ["string", "null"]},
    "references": {"type": "array", "items": {"type": "string", "format": "uri"}, "uniqueItems": true},
    "normalization": {"$ref": "#/$defs/normalization"},
    "raw_sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/raw_source"}}
  },
  "$defs": {
    "nullable_string": {"type": ["string", "null"]},
    "nullable_positive_integer": {"type": ["integer", "null"], "minimum": 1},
    "tool": {"type": "object", "additionalProperties": false, "required": ["name", "version", "scan_type"], "properties": {"name": {"enum": ["semgrep", "zap", "codeql"]}, "version": {"$ref": "#/$defs/nullable_string"}, "scan_type": {"enum": ["SAST", "DAST"]}}},
    "scan": {"type": "object", "additionalProperties": false, "required": ["run_id", "pipeline_run_id", "scanned_at"], "properties": {"run_id": {"type": "string", "minLength": 1}, "pipeline_run_id": {"$ref": "#/$defs/nullable_string"}, "scanned_at": {"type": "string", "format": "date-time"}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["name", "version", "commit_sha", "base_url"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"$ref": "#/$defs/nullable_string"}, "commit_sha": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}$"}, "base_url": {"type": ["string", "null"], "format": "uri"}}},
    "rule": {"type": "object", "additionalProperties": false, "required": ["id", "reference_id", "name", "native_severity", "native_confidence"], "properties": {"id": {"type": "string", "minLength": 1}, "reference_id": {"$ref": "#/$defs/nullable_string"}, "name": {"$ref": "#/$defs/nullable_string"}, "native_severity": {"$ref": "#/$defs/nullable_string"}, "native_confidence": {"$ref": "#/$defs/nullable_string"}}},
    "code_location": {"type": "object", "additionalProperties": false, "required": ["kind", "path", "start_line", "start_column", "end_line", "end_column"], "properties": {"kind": {"const": "code"}, "path": {"type": "string", "minLength": 1}, "start_line": {"type": "integer", "minimum": 1}, "start_column": {"$ref": "#/$defs/nullable_positive_integer"}, "end_line": {"type": "integer", "minimum": 1}, "end_column": {"$ref": "#/$defs/nullable_positive_integer"}}},
    "http_location": {"type": "object", "additionalProperties": false, "required": ["kind", "uri", "endpoint", "method", "parameter"], "properties": {"kind": {"const": "http"}, "uri": {"type": "string", "format": "uri"}, "endpoint": {"type": "string", "pattern": "^/"}, "method": {"type": ["string", "null"], "pattern": "^[A-Z]+$"}, "parameter": {"$ref": "#/$defs/nullable_string"}}},
    "flow_node": {"type": "object", "additionalProperties": false, "required": ["step_index", "path", "line", "column", "content", "message"], "properties": {"step_index": {"type": "integer", "minimum": 0}, "path": {"$ref": "#/$defs/nullable_string"}, "line": {"$ref": "#/$defs/nullable_positive_integer"}, "column": {"$ref": "#/$defs/nullable_positive_integer"}, "content": {"$ref": "#/$defs/nullable_string"}, "message": {"$ref": "#/$defs/nullable_string"}}},
    "data_flow": {"type": "object", "additionalProperties": false, "required": ["kind", "engine", "source", "steps", "sink"], "properties": {"kind": {"const": "taint"}, "engine": {"enum": ["semgrep", "codeql"]}, "source": {"$ref": "#/$defs/flow_node"}, "steps": {"type": "array", "items": {"$ref": "#/$defs/flow_node"}}, "sink": {"$ref": "#/$defs/flow_node"}}},
    "normalization": {"type": "object", "additionalProperties": false, "required": ["normalizer_version", "normalized_at"], "properties": {"normalizer_version": {"const": "1.0.0"}, "normalized_at": {"type": "string", "format": "date-time"}}},
    "raw_source": {"type": "object", "additionalProperties": false, "required": ["format", "report_path", "json_pointer"], "properties": {"format": {"enum": ["semgrep-json", "zap-json", "codeql-sarif", "codeql-sarif-rule"]}, "report_path": {"type": "string", "minLength": 1}, "json_pointer": {"type": "string", "pattern": "^(|/.*)$"}}}
  }
}
